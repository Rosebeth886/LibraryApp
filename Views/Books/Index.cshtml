@model List<Book>
<table class="table">
    <tr>
        <th>Cím</th>
        <th>Év</th>
        <th>Szerző</th>
        <th></th>
    </tr>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.Title</td>
            <td>@b.Year</td>
            <td>@b.Author?.Name</td>
            <td><a asp-action="Edit" asp-route-id="@b.Id">Szerkeszt</a></td>
        </tr>
    }
</table>